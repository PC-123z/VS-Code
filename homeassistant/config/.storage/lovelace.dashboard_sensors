                {
                  "type": "markdown",
                  "content": "{%- set rssi_warn = -75 %}\n{%- set batt_warn = 25 %}\n{%- set fw_max_days = 180 %}\n{%- set quiet_hours = 48 %}\n{%- set signals = label_entities('presence_signal') %}\n{%- set ns = namespace(rows=[], bad=0) %}\n{%- for d in label_devices('presence_sensor') %}\n  {%- set name = device_attr(d, 'name_by_user') or device_attr(d, 'name') %}\n  {%- set ents = device_entities(d) %}\n  {%- set e = namespace(online=none, rssi=none, batt=none, upd=false, last=none, total=0, dead=0) %}\n  {%- for x in ents %}\n    {%- set s = states(x) %}\n    {%- set dc = state_attr(x, 'device_class') %}\n    {%- if x.startswith('sensor.') or x.startswith('binary_sensor.') %}\n      {%- set e.total = e.total + 1 %}\n      {%- if s == 'unavailable' %}{% set e.dead = e.dead + 1 %}{% endif %}\n    {%- endif %}\n    {%- if x.endswith('_online') and x.startswith('binary_sensor.') %}{% set e.online = s == 'on' %}{% endif %}\n    {%- if x.startswith('sensor.') and dc == 'signal_strength' and s | is_number %}{% set e.rssi = s | float %}{% endif %}\n    {%- if x.startswith('sensor.') and dc == 'battery' and s | is_number %}{% set e.batt = s | float %}{% endif %}\n    {%- if x.startswith('update.') and s == 'on' %}{% set e.upd = true %}{% endif %}\n    {%- if x in signals and states[x] is not none %}\n      {%- set t = as_timestamp(states[x].last_changed) %}\n      {%- if e.last is none or t > e.last %}{% set e.last = t %}{% endif %}\n    {%- endif %}\n  {%- endfor %}\n  {%- if e.online is none %}{% set e.online = e.total > 0 and e.dead < e.total %}{% endif %}\n  {%- set sw = (device_attr(d, 'sw_version') or '—') | regex_replace(' \\\\(ESPHome.*\\\\)', '') %}\n  {%- set issues = [] %}\n  {%- if not e.online %}{% set issues = issues + ['offline'] %}{% endif %}\n  {%- if e.rssi is not none and e.rssi < rssi_warn %}{% set issues = issues + ['weak Wi-Fi'] %}{% endif %}\n  {%- if e.batt is not none and e.batt < batt_warn %}{% set issues = issues + ['low battery'] %}{% endif %}\n  {%- if e.upd %}{% set issues = issues + ['update available'] %}{% endif %}\n  {%- if device_attr(d, 'manufacturer') == 'ApolloAutomation' and sw is match('\\\\d+\\\\.\\\\d+\\\\.\\\\d+') %}\n    {%- set p = sw.split('.') %}\n    {%- set built = as_timestamp(strptime('20' ~ p[0] ~ '-' ~ p[1] ~ '-' ~ p[2], '%Y-%m-%d')) %}\n    {%- if (as_timestamp(now()) - built) / 86400 > fw_max_days %}{% set issues = issues + ['firmware > 6 mo'] %}{% endif %}\n  {%- endif %}\n  {%- if e.last is not none and (as_timestamp(now()) - e.last) / 3600 > quiet_hours %}{% set issues = issues + ['no activity ' ~ quiet_hours ~ ' h'] %}{% endif %}\n  {%- if issues %}{% set ns.bad = ns.bad + 1 %}{% endif %}\n  {%- set ago = '—' if e.last is none else relative_time(as_datetime(e.last)) ~ ' ago' %}\n  {%- set row = [\n      ('⚠️' if issues else '✅') ~ ' ' ~ name,\n      device_attr(d, 'model') or '—',\n      area_name(d) or '—',\n      '🟢' if e.online else '🔴',\n      ('%d dBm' | format(e.rssi)) if e.rssi is not none else '—',\n      ('%d%%' | format(e.batt)) if e.batt is not none else '—',\n      sw ~ (' ⬆' if e.upd else ''),\n      ago,\n      issues | join(', ') or 'OK'] %}\n  {%- set ns.rows = ns.rows + [(0 if issues else 1, name, row)] %}\n{%- endfor %}\n**{{ ns.rows | count }} devices · {{ ns.rows | count - ns.bad }} healthy · {{ ns.bad }} need attention**\n\n| Device | Model | Area | Online | Wi-Fi | Battery | Firmware | Last activity | Status |\n|---|---|---|:-:|---|---|---|---|---|\n{%- for r in ns.rows | sort(attribute='1') | sort(attribute='0') %}\n| {{ r[2] | join(' | ') }} |\n{%- endfor %}\n\n<sub>Flags: offline · Wi-Fi below {{ rssi_warn }} dBm · battery below {{ batt_warn }}% · update available · Apollo firmware older than {{ fw_max_days }} days · no presence change in {{ quiet_hours }} h. Devices come from the <b>Presence Sensor</b> label.</sub>\n",
