# Exclude everything in HA config except what we explicitly want
homeassistant/config/.cloud/
homeassistant/config/deps/
homeassistant/config/tts/
homeassistant/config/.cache/
homeassistant/config/backups/
homeassistant/config/www/
homeassistant/config/custom_components/
homeassistant/config/secrets.yaml

# .storage — block sensitive/runtime files, allow config files
homeassistant/config/.storage/auth
homeassistant/config/.storage/auth_provider.*
homeassistant/config/.storage/http
homeassistant/config/.storage/http.auth
homeassistant/config/.storage/application_credentials
homeassistant/config/.storage/cloud
homeassistant/config/.storage/onboarding
homeassistant/config/.storage/core.restore_state
homeassistant/config/.storage/core.uuid
homeassistant/config/.storage/core.analytics
homeassistant/config/.storage/trace.saved_traces
homeassistant/config/.storage/bluetooth.*
homeassistant/config/.storage/esphome.*
homeassistant/config/.storage/reolink.*
homeassistant/config/.storage/hacs.*
homeassistant/config/.storage/homekit.*.aids
homeassistant/config/.storage/homekit.*.iids
homeassistant/config/.storage/homekit.*.state
homeassistant/config/.storage/frontend.user_data_*
homeassistant/config/.storage/frontend.system_data
homeassistant/config/.storage/core.config_entries.bak.*
homeassistant/config/.storage/backup
homeassistant/config/.storage/androidtv_remote_*
homeassistant/config/.storage/core.config_entries

# Exclude these entire services
music-assistant/
ring-mqtt/
piper/

# General
__pycache__/
node_modules/
*.db
*.log
*.sqlite
*.zip
*.tar.gz
*.mp3

# HA generated/sensitive files
homeassistant/config/.HA_VERSION
homeassistant/config/.ha_run.lock
homeassistant/config/.claude/
homeassistant/config/home-assistant.log*
homeassistant/config/*.db
homeassistant/config/*.db-shm
homeassistant/config/*.db-wal
homeassistant/config/*.db.corrupt*
homeassistant/config/*.pem
homeassistant/config/coordinator.py
